{
  "name": "chronica",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @chronica/web",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @chronica/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "maps:graph": "tsx scripts/map-gen/build-map-graph.ts && tsx scripts/map-gen/resolve-extra-anchors.ts && tsx scripts/map-gen/describe-map-asset.ts",
    "maps:simplify": "node scripts/simplify-geojson.mjs",
    "validate:scenario": "tsx scripts/validate-scenario.ts",
    "play": "tsx scripts/hand-played-burst.mts",
    "play:turn": "tsx --env-file=.env.local scripts/play-turn.mts",
    "eval:orders": "tsx scripts/eval-orders/run.mts",
    "audit:deltas": "tsx scripts/delta-audit.mts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^15.5.23",
    "eslint": "^9.39.1",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
