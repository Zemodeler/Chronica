# Chronica — copy to .env.local and fill in. NEVER commit a filled-in copy.
# See docs/05-ai-layer.md for the provider abstraction and docs/06-cost-model.md for budgets.

# ---------------------------------------------------------------------------
# Database (Postgres 16+). Local dev: docker run postgres, or a Neon branch.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://chronica:chronica@localhost:5432/chronica

# ---------------------------------------------------------------------------
# Developer-funded AI — configure exactly one active production provider.
# Players never supply keys or choose a provider; hosts choose only a hard match cap.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Azure AI Foundry uses server-side managed identity. Deployment is a configured
# alias (for example the deployment serving gpt-5.6-luna), never a browser value.
AZURE_AI_ENDPOINT=
AZURE_AI_DEPLOYMENT=

# Local/offline adapter (Ollama or any OpenAI-compatible endpoint). Zero
# marginal cost; useful for development so tests never spend money.
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=

# Active provider for this deployment: anthropic | openai | local
CHRONICA_AI_PROVIDER=local
# The developer account screen can select OpenAI or Anthropic in a local
# development server. It stores only the selected provider in an ignored file.
# Optional override for that ignored selection file:
CHRONICA_LOCAL_AI_SETTINGS_FILE=
# Comma-separated model choices offered in the local developer screen.
CHRONICA_LOCAL_OPENAI_MODELS=gpt-5.6-luna,gpt-5-nano,gpt-5.6-sol
CHRONICA_LOCAL_ANTHROPIC_MODELS=claude-haiku-4-5,claude-sonnet-4-5,claude-opus-4-5
CHRONICA_AI_ENABLED=
# Development only: route worker AI through an authenticated local Codex CLI.
# Never enable this in a deployed environment; it has no provider token telemetry.
CHRONICA_DEV_CLI_AI=
CHRONICA_CODEX_CLI_PATH=
# Immutable database-backed operation-routing profile selected for new work.
CHRONICA_ACTIVE_AI_PROFILE_VERSION=1

# ---------------------------------------------------------------------------
# Accounts and email. Console transport is development-only.
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
CHRONICA_EMAIL_FROM=
# Google OAuth is optional. Configure the production callback in Google Cloud as
# https://your-domain.example/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The verified andrei.dodu@icloud.com identity is bootstrapped as Zemodeler.

# ---------------------------------------------------------------------------
# Dormant Paddle Merchant of Record configuration. Buying coins is not exposed
# in this release. Product price IDs
# are read only by packages/billing/src/adapters/ and map to the stable slugs
# credits_small, credits_medium, credits_large and chronica_monthly.
# ---------------------------------------------------------------------------
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_CREDITS_SMALL=
PADDLE_PRICE_CREDITS_MEDIUM=
PADDLE_PRICE_CREDITS_LARGE=
PADDLE_PRICE_CHRONICA_MONTHLY=

# Server-side pepper for hashing gift codes. Required for creating and
# redeeming codes; generate it once and keep the same value for the lifetime
# of the deployment, otherwise previously created codes cannot be redeemed.
# Example: openssl rand -hex 32
CHRONICA_GIFT_CODE_PEPPER=

# ---------------------------------------------------------------------------
# Coin defaults. One displayed coin is USD 1 and 1,000,000 micro-units. These are
# decimal integer strings; production catalog grants and prices are deployment
# data and a missing mapping keeps that product disabled.
# ---------------------------------------------------------------------------
CHRONICA_DEFAULT_MATCH_CAP_MICROCREDITS=200000

# ---------------------------------------------------------------------------
# Web / worker
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Public origin, used for invite links and SSE reconnects.
CHRONICA_PUBLIC_URL=http://localhost:3000
# Secret for signing sessions and invite links. Generate: openssl rand -hex 32
CHRONICA_SESSION_SECRET=
