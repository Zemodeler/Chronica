{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Chronica Web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Chronica Web (mock AI)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev-env.mjs",
        "CHRONICA_AI_MODE=mock",
        "npm",
        "run",
        "dev",
        "--workspace",
        "@chronica/web",
        "--",
        "-p",
        "3200"
      ],
      "port": 3200
    },
    {
      "name": "Chronica Web (hand, manual)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev-env.mjs",
        "CHRONICA_AI_MODE=hand",
        "CHRONICA_HAND_RESPONDER=manual",
        "CHRONICA_HAND_DIR=eval-out/hand-armies-web",
        "npm",
        "run",
        "dev",
        "--workspace",
        "@chronica/web",
        "--",
        "-p",
        "3300"
      ],
      "port": 3300
    }
  ]
}
